{
  "name": "atlas-ip",
  "version": "1.0.0",
  "private": true,
  "description": "Atlas IP — Collectiverse Character & Brand Bible (Canonical Source)",
  "type": "module",
  "scripts": {
    "atlas:validate": "tsx scripts/validate-atlas-assets.ts",
    "atlas:resize": "tsx scripts/resize-poses.ts --new",
    "atlas:resize:force": "tsx scripts/resize-poses.ts --force",
    "atlas:manifest": "tsx scripts/generate-atlas-manifest.ts",
    "atlas:types": "tsx scripts/generate-types.ts",
    "atlas:hashes": "tsx scripts/compare-hashes.ts",
    "atlas:sync": "tsx scripts/validate-atlas-assets.ts && tsx scripts/resize-poses.ts --new && tsx scripts/generate-atlas-manifest.ts && tsx scripts/generate-types.ts",
    "atlas:deploy": "bash scripts/deploy-to-app.sh",
    "atlas:deploy:dry": "bash scripts/deploy-to-app.sh --dry-run",
    "comic:generate": "tsx scripts/generate-comic-panel.ts",
    "comic:strip": "tsx scripts/compose-comic-strip.ts",
    "comic:full": "tsx scripts/generate-full-comic.ts"
  },
  "devDependencies": {
    "sharp": "^0.33.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@fal-ai/client": "^1.10.1",
    "canvas": "^3.1.0",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0"
  }
}
