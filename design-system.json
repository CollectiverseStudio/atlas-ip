{
  "name": "Collectiverse Design System",
  "version": "1.0",
  "colors": {
    "brand": {
      "primary-blue": "#2F7DF6",
      "dark-navy": "#1B2B5E",
      "gold": "#F5C542",
      "atlas-green": "#66FF99"
