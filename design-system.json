        "size": 20,
        "weight": 600,
        "lineHeight": 1.4
      },
      "h4": {
        "size": 16,
        "weight": 600,
        "lineHeight": 1.4
      }
    },
    "body": {
      "large": {
        "size": 16,
        "weight": 400,
        "lineHeight": 1.5
