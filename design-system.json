    },
    {
      "name": "Smart Capture",
      "width": 390,
      "height": 844,
      "description": "Mobile camera scanner identifying a card"
    },
    {
      "name": "Atlas Chat",
      "width": 1440,
      "height": 900,
      "description": "Atlas AI assistant with price recommendations"
